# Application
APP_NAME=Monetry API
APP_ENV=development
APP_PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=monetry
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# JWT
JWT_SECRET=change-me-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Rate limiter (request per menit per IP)
RATE_LIMIT_MAX=120

# Seed admin (dibuat otomatis saat aplikasi pertama kali dijalankan)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@monetry.local
SEED_ADMIN_PASSWORD=Admin#12345

